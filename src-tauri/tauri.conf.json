{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D Hoard Deck",
  "version": "0.1.0",
  "identifier": "dev.ragin.hoarddeck",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "3D Hoard Deck",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: hoard: http://hoard.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost hoard: http://hoard.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
